package main

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ LoginPage() {
	@Layout("Renia - Login") {
		<div class="container">
			<h1>Renia</h1>
			<div class="auth-box">
				<div class="tabs">
					<button class="tab active" onclick="showTab('login')">Login</button>
					<button class="tab" onclick="showTab('register')">Register</button>
				</div>
				<div id="login-tab" class="tab-content active">
					<form id="login-form" onsubmit="handleLogin(event)">
						<input type="text" id="login-username" placeholder="Username" required/>
						<input type="password" id="login-password" placeholder="Password" required/>
						<button type="submit">Login</button>
					</form>
				</div>
				<div id="register-tab" class="tab-content">
					<form id="register-form" onsubmit="handleRegister(event)">
						<input type="text" id="register-username" placeholder="Username" required/>
						<input type="password" id="register-password" placeholder="Password" required/>
						<button type="submit">Register</button>
					</form>
				</div>
				<div id="auth-message"></div>
			</div>
		</div>
		<script src="/static/auth.js"></script>
	}
}

templ ChatPage() {
	@Layout("Renia - Chat") {
		<div class="app">
			<aside class="sidebar">
				<div class="sidebar-header">
					<h3>Chats</h3>
					<button onclick="createNewSession()">+ New</button>
				</div>
				<div class="workspace-bar">
					<select id="workspace-select" onchange="onWorkspaceChange()">
						<option value="">No workspace</option>
					</select>
					<button onclick="showWorkspaceModal()">+</button>
				</div>
				<ul id="session-list" class="session-list"></ul>
				<div class="sidebar-footer">
					<div class="mode-toggle">
						<label>Mode:</label>
						<select id="mode-select" onchange="setMode(this.value)">
							<option value="approval">Approval</option>
							<option value="yolo">YOLO</option>
						</select>
					</div>
					<button onclick="logout()">Logout</button>
				</div>
			</aside>
			<div class="chat-container">
				<div class="chat-header">
					<h2 id="chat-title">Renia</h2>
				</div>
				<div id="messages" class="messages"></div>
				<div id="approval-box" class="approval-box hidden">
					<div class="approval-text" id="approval-text"></div>
					<div class="approval-actions">
						<button class="approve-btn" onclick="approvePending()">Approve</button>
						<button class="reject-btn" onclick="rejectPending()">Reject</button>
					</div>
				</div>
					<div id="changes-box" class="changes-box hidden">
						<div class="changes-preview" id="changes-preview"></div>
						<div class="changes-actions">
							<button class="approve-btn" onclick="applyPendingChanges()">Apply</button>
							<button class="reject-btn" onclick="rejectPendingChanges()">Reject</button>
						</div>
					</div>
				<form id="chat-form" class="chat-input" onsubmit="handleChat(event)">
					<textarea id="prompt" placeholder="Type a message..." autocomplete="off" required rows="1"></textarea>
					<button type="submit">Send</button>
				</form>
			</div>
		</div>
		<div id="workspace-modal" class="modal hidden">
			<div class="modal-content">
				<h3>Add Workspace</h3>
				<input type="text" id="ws-name" placeholder="Name" required/>
				<input type="text" id="ws-path" placeholder="Absolute path" required/>
				<div class="modal-actions">
					<button onclick="hideWorkspaceModal()">Cancel</button>
					<button onclick="addWorkspace()">Add</button>
				</div>
			</div>
		</div>
		<script src="/static/chat.js"></script>
	}
}
